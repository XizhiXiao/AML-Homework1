{
  "model": {
    "vocab_size": 16000,
    "context_length": 1024,
    "d_model": 1024,
    "n_layers": 16,
    "n_heads": 16,
    "d_ff": 4096,
    "dropout": 0.0,
    "tie_weights": true
  },
  "train": {
    "seed": 42,
    "device": "auto",
    "precision": "bf16",
    "micro_batch_size": 4,
    "gradient_accumulation": 64,
    "max_steps": 4000,
    "learning_rate": 0.0004,
    "min_lr_ratio": 0.1,
    "warmup_steps": 80,
    "weight_decay": 0.1,
    "betas": [
      0.9,
      0.95
    ],
    "grad_clip": 1.0,
    "eval_interval": 100,
    "log_interval": 10,
    "save_interval": 100,
    "eval_documents": 128
  }
}
